# Build artifacts
/target
/vendor/baseview/target
/vendor/egui-baseview/target
**/*.rs.bk

# Bundled plugin outputs (re-generated via `cargo xtask bundle`)
/target/bundled
# Release package outputs (zip/sha/manifest; publish as release assets, never commit)
/dist
# External-SDK AAX build outputs (generated locally; never publish build trees)
/build-aax/
/build-aax-universal/
/build-aax-windows/
# Per-release operator state (product targets, upload readiness, and handoff notes)
# is local-only. Public artifact manifests are emitted under /dist and attached to
# GitHub Releases instead of being committed to source history.
/release_state/
# Runtime-generated plugin data (structure belongs in code / docs, not in git)
/plugin_data
**/plugin_data/
# /tmp/ IPC directory mirrors — never commit runtime measurement state
/tmp/kirin
# Debug/diagnostic log captures (fork-debug + generic catchall)
hypha_fork_debug*.log
*.log
# macOS
.DS_Store
# Editors
.idea/
.vscode/
*.swp
*~
# Per-machine local tool settings
.*/settings.local.json
# Keep tracked toolchain configuration reproducible; machine overrides stay local.
# Private investigations and temporary exports
B-*.md
hypha_first_click_repro*.md
hypha_phase*_completeness_audit*.md
tmp/
/local_audits/
/security_state/
# Defensive: secret / credential patterns
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
.env*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
secrets.toml
*_secret.txt
*_api_key.txt
# Local credentials/configuration, not public example templates
credentials.local.*
secrets.local.*
*.private.json
*.local.p12
*.local.pfx
*.mobileprovision
# Crash dumps and temporary exports
*.dmp
*.core
core.[0-9]*
*.crash
*.ips
/export_tmp/
