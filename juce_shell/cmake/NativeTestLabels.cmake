# Add metadata only; existing test names, fixtures, regex selections and gates stay intact.
get_property(kirin_label_tests DIRECTORY PROPERTY TESTS)
foreach(test IN LISTS kirin_label_tests)
    set(domain general)
    if(test MATCHES "^kirin_native_(storage_guard|path)")
        set(domain safety)
    elseif(test MATCHES "(live_|listen|reaper_|clock|double_precision|output_ownership)")
        set(domain audio)
    elseif(test MATCHES "(reference|local_blind)")
        set(domain reference)
    elseif(test MATCHES "(capture|record|keep|storage)")
        set(domain record)
    elseif(test MATCHES "(update|host_identity|snapshot_abi)")
        set(domain platform)
    elseif(test MATCHES "(ui_|editor_|shortcut|text|visual|attack)")
        set(domain ui)
    endif()
    set_property(TEST "${test}" APPEND PROPERTY LABELS "hypha-all" "hypha-${domain}")
endforeach()
