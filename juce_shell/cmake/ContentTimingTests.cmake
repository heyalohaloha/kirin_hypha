    # Compile the wrapper's actual state callbacks against the native processor, without an SDK
    # or a plug-in bundle. The fixture supplies only the surrounding AAX interface types.
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/JUCE/modules/juce_audio_plugin_client/juce_audio_plugin_client_AAX.cpp" aax_wrapper)
    function(kirin_extract_aax_state name begin end)
        string(FIND "${aax_wrapper}" "${begin}" callback_start)
        string(FIND "${aax_wrapper}" "${end}" callback_end)
        if(callback_start LESS 0 OR callback_end LESS callback_start)
            message(FATAL_ERROR "AAX state callback boundary changed: ${name}")
        endif()
        math(EXPR callback_length "${callback_end} - ${callback_start}")
        string(SUBSTRING "${aax_wrapper}" ${callback_start} ${callback_length} callback_body)
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/${name}.h" "${callback_body}")
    endfunction()
    kirin_extract_aax_state(AaxStateChunkBody "        AAX_Result GetChunkSize (" "        AAX_Result ResetFieldData (")
    kirin_extract_aax_state(AaxStateChangesBody "        AAX_Result GetNumberOfChanges (" "        AAX_Result UpdateParameterNormalizedValue (")
    kirin_extract_aax_state(AaxStateDirtyBody "        void audioProcessorChanged (" "        void audioProcessorParameterChangeGestureBegin (")
