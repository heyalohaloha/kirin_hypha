add_executable(KirinStoragePathsTests tests/storage_paths_test.cpp)
target_compile_features(KirinStoragePathsTests PRIVATE cxx_std_17)
target_compile_options(KirinStoragePathsTests PRIVATE ${KIRIN_SOURCE_ENCODING_ARGS})
target_compile_definitions(KirinStoragePathsTests PRIVATE "$<TARGET_PROPERTY:KirinHyphaPOST,COMPILE_DEFINITIONS>")
target_include_directories(KirinStoragePathsTests PRIVATE "$<TARGET_PROPERTY:KirinHyphaPOST,INCLUDE_DIRECTORIES>")
target_link_libraries(KirinStoragePathsTests PRIVATE KirinHyphaPOST juce::juce_recommended_warning_flags)
foreach(scenario environment sandbox defaults relative unwritable)
    add_test(NAME kirin_storage_paths_${scenario} COMMAND KirinStoragePathsTests ${scenario})
    set_tests_properties(kirin_storage_paths_${scenario} PROPERTIES TIMEOUT 30)
endforeach()
