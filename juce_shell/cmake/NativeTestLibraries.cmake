# JUCE modules are INTERFACE libraries containing sources. Linking one into every
# executable recompiles it for every test. Own those sources in static libraries;
# forward only header usage requirements, never INTERFACE_SOURCES, to consumers.
# Shipping PRE/POST, format wrappers and the clock-injected processor stay separate.
function(kirin_share_native_test_libraries)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    set(consumers)
    foreach(target IN LISTS targets)
        get_target_property(type ${target} TYPE)
        if(NOT type STREQUAL "EXECUTABLE" OR target STREQUAL "KirinAudioTransparencyContractTests")
            continue()
        endif()
        get_target_property(links ${target} LINK_LIBRARIES)
        set(modules)
        foreach(link IN LISTS links)
            if(link MATCHES "^juce::juce_" AND NOT link MATCHES "^juce::juce_recommended_")
                list(APPEND modules ${link})
            endif()
        endforeach()
        if(NOT modules)
            list(APPEND consumers ${target})
            continue()
        endif()
        get_target_property(definitions ${target} COMPILE_DEFINITIONS)
        set(juce_definitions)
        foreach(definition IN LISTS definitions)
            if(definition MATCHES "^JUCE_")
                list(APPEND juce_definitions "${definition}")
            endif()
        endforeach()
        list(SORT juce_definitions)
        string(SHA256 profile "${juce_definitions}")
        string(SUBSTRING "${profile}" 0 12 profile)
        set(library KirinNativeJuce_${profile})
        if(NOT TARGET ${library})
            add_library(${library} STATIC)
            target_compile_definitions(${library} PRIVATE ${juce_definitions})
            target_link_libraries(${library} PRIVATE juce::juce_recommended_config_flags
                juce::juce_recommended_warning_flags)
            # These properties include JUCE's transitive includes/definitions/features.
            # PRIVATE module links supply platform frameworks through LINK_ONLY.
            foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_FEATURES)
                set_property(TARGET ${library} PROPERTY INTERFACE_${property}
                    "$<TARGET_PROPERTY:${library},${property}>")
            endforeach()
        endif()
        target_link_libraries(${library} PRIVATE ${modules})
        list(REMOVE_ITEM links ${modules})
        set_property(TARGET ${target} PROPERTY LINK_LIBRARIES "${links}")
        target_link_libraries(${target} PRIVATE ${library})
        list(APPEND consumers ${target})
    endforeach()

    # Preserve all non-JUCE compile definitions (page hooks, transport injection,
    # etc.) when pooling product sources. Different compile contexts get different
    # archives. Test entry points and their stubs remain in their own executables.
    foreach(target IN LISTS consumers)
        get_target_property(sources ${target} SOURCES)
        set(product_sources)
        set(test_sources)
        foreach(source IN LISTS sources)
            cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
                NORMALIZE OUTPUT_VARIABLE source_path)
            string(FIND "${source_path}" "${CMAKE_CURRENT_SOURCE_DIR}/src/" product_prefix)
            if(product_prefix EQUAL 0 AND source_path MATCHES "\\.(cpp|mm)$")
                list(APPEND product_sources "${source_path}")
            else()
                list(APPEND test_sources "${source}")
            endif()
        endforeach()
        if(NOT product_sources)
            continue()
        endif()
        set(signature "")
        foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES INCLUDE_DIRECTORIES LINK_LIBRARIES)
            get_target_property(value ${target} ${property})
            if(NOT value)
                set(value "")
            endif()
            if(property STREQUAL "INCLUDE_DIRECTORIES")
                # juce_add_console_app supplies a per-app JuceLibraryCode directory.
                # Product files use module headers directly, never generated JuceHeader.h.
                list(FILTER value EXCLUDE REGEX "(_artefacts/JuceLibraryCode$|,JUCE_GENERATED_SOURCES_DIRECTORY>)")
            endif()
            set(saved_${property} "${value}")
            string(APPEND signature "${property}=${value}\n")
        endforeach()
        string(SHA256 profile "${signature}")
        string(SUBSTRING "${profile}" 0 12 profile)
        set(library KirinNativeSources_${profile})
        if(NOT TARGET ${library})
            add_library(${library} STATIC)
            foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES INCLUDE_DIRECTORIES)
                set_property(TARGET ${library} PROPERTY ${property} "${saved_${property}}")
            endforeach()
            target_link_libraries(${library} PRIVATE ${saved_LINK_LIBRARIES})
        endif()
        target_sources(${library} PRIVATE ${product_sources})
        get_target_property(dependencies ${target} MANUALLY_ADDED_DEPENDENCIES)
        if(dependencies)
            add_dependencies(${library} ${dependencies})
        endif()
        set_property(TARGET ${target} PROPERTY SOURCES "${test_sources}")
        target_link_libraries(${target} PRIVATE ${library})
    endforeach()
endfunction()

kirin_share_native_test_libraries()
