if(KIRIN_HYPHA_BUILD_UI_RENDER_TESTS)
    foreach(role IN ITEMS PRE POST)
        set(target KirinShortcut${role}Tests)
        add_executable(${target} tests/shortcut_product_test.cpp tests/ShortcutActionContractTest.cpp
                       tests/ShortcutKeyContractTest.cpp tests/ShortcutMarkContractTest.cpp
                       tests/ShortcutReferenceNavigationTest.cpp)
        if(APPLE)
            target_sources(${target} PRIVATE tests/BlindProductMacRunLoop.mm)
        endif()
        if(role STREQUAL "PRE")
            target_sources(${target} PRIVATE ${KIRIN_REFERENCE_AUDITION_SOURCES})
        endif()
        target_compile_features(${target} PRIVATE cxx_std_17)
        target_compile_options(${target} PRIVATE ${KIRIN_SOURCE_ENCODING_ARGS})
        target_compile_definitions(${target} PRIVATE "$<TARGET_PROPERTY:KirinHypha${role},COMPILE_DEFINITIONS>")
        target_include_directories(${target} PRIVATE "$<TARGET_PROPERTY:KirinHypha${role},INCLUDE_DIRECTORIES>")
        target_link_libraries(${target} PRIVATE KirinHypha${role} juce::juce_recommended_warning_flags)
        string(TOLOWER "${role}" role_lower)
        add_test(NAME kirin_shortcut_${role_lower}_actions COMMAND ${target} actions)
        set_tests_properties(kirin_shortcut_${role_lower}_actions PROPERTIES TIMEOUT 120)
    endforeach()
endif()
