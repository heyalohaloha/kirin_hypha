+    tresult PLUGIN_API setAudioPresentationLatencySamples (Vst::BusDirection dir,
+                                                            Steinberg::int32 busIndex,
+                                                            Steinberg::uint32 latencyInSamples) override
+    {
+        if (busIndex != 0)
+            return kInvalidArgument;
+
+        if (dir == Vst::kInput)
+        {
+            inputPresentationLatencySamples.store ((int64_t) latencyInSamples, std::memory_order_release);
+            return kResultOk;
+        }
+
+        if (dir == Vst::kOutput)
+        {
+            outputPresentationLatencySamples.store ((int64_t) latencyInSamples, std::memory_order_release);
+            return kResultOk;
+        }
+
+        return kInvalidArgument;
+    }
