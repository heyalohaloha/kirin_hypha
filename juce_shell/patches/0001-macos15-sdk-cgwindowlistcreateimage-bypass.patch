@@ -520,24 +520,34 @@ static Image createNSWindowSnapshot (NSWindow* nsWindow)
 {
     JUCE_AUTORELEASEPOOL
     {
+       #if defined (__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 150000
+        // Kirin patch (Phase 2 後段 / kirin_hypha): CGWindowListCreateImage is obsoleted
+        // (unavailable -> hard error) in the macOS 15.0 SDK. JUCE 7.0.12 has no backport
+        // (fixed only in JUCE 8.0.x). The Watch audio plugin never snapshots native windows,
+        // so we bypass the obsoleted path and return an empty Image when built against a
+        // 15.0+ SDK. Scope: this GUI snapshot utility only; audio/measurement/plugin/UI paths
+        // are untouched. See juce_shell/PATCHES.md.
+        ignoreUnused (nsWindow);
+        return {};
+       #else
         // CGWindowListCreateImage is replaced by functions in the ScreenCaptureKit framework, but
