// END generated by scripts/windows/installer_user_cleanup.mjs

function HyphaRunUserCleanup(Command, Mode: String): Integer;
var
  ResultCode: Integer;
begin
  if ExecAsOriginalUser(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
       '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ' + Command,
       '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Result := ResultCode
  else
    Result := -1;
  Log('Kirin Hypha: ' + Mode + ' of the current-user copy of the user who started Setup returned ' + IntToStr(Result));
end;

function HyphaAllUsersCopyFound: Boolean;
begin
  Result := RegKeyExists(HKEY_LOCAL_MACHINE, HyphaUninstallKey) or
    DirExists(ExpandConstant('{commoncf}\VST3\Kirin Hypha PRE.vst3')) or
    DirExists(ExpandConstant('{commoncf}\VST3\Kirin Hypha POST.vst3'));
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Code: Integer;
begin
  Result := '';
  if IsAdminInstallMode then
  begin
    Code := HyphaRunUserCleanup(HyphaUserCleanupRemoveCommand, 'removal');
    // 0 removed or none; 20 in use, nothing changed; 21, 22, 30 the script ran but could not finish;
    // anything else (-1 when Windows PowerShell could not start) means the copy was never checked.
    if Code = HyphaUserCopyInUse then
      Result := CustomMessage('HyphaMigrationInUse')
    else if (Code = 21) or (Code = 22) or (Code = 30) then
      Result := CustomMessage('HyphaMigrationFailed')
    else if Code <> 0 then
      Result := CustomMessage('HyphaMigrationUnchecked');
  end
  else if HyphaAllUsersCopyFound then
  begin
    Log('Kirin Hypha: refusing a current-user installation beside the all-users installation');
    Result := CustomMessage('HyphaAllUsersPresent');
  end;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := '';
  if IsAdminInstallMode then
    if HyphaRunUserCleanup(HyphaUserCleanupCheckCommand, 'check') = HyphaUserCopyFound then
      Result := CustomMessage('HyphaMigrationReadyMemo');
end;
