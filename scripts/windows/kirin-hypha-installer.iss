#ifndef AppVersion
  #error AppVersion is required
#endif
#ifndef OutputDir
  #error OutputDir is required
#endif
#ifndef PreBundle
  #error PreBundle is required
#endif
#ifndef PostBundle
  #error PostBundle is required
#endif
#ifdef WithAax
  #ifndef PreAaxBundle
    #error PreAaxBundle is required with AAX
  #endif
  #ifndef PostAaxBundle
    #error PostAaxBundle is required with AAX
  #endif
#endif

[Setup]
AppId={{B3301A1C-4782-4E36-9B4D-89CC6C5B701E}
AppName=Kirin Hypha
AppVersion={#AppVersion}
AppPublisher=Kirin Mastering
AppPublisherURL=https://kirinmastering.com/hypha
AppSupportURL=https://github.com/heyalohaloha/kirin_hypha/issues
AppUpdatesURL=https://github.com/heyalohaloha/kirin_hypha/releases
VersionInfoVersion={#AppVersion}
VersionInfoCompany=Kirin Mastering
#ifdef WithAax
VersionInfoDescription=Kirin Hypha Windows VST3 + AAX Installer
#else
VersionInfoDescription=Kirin Hypha Windows VST3 Installer
#endif
VersionInfoProductName=Kirin Hypha
DefaultDirName={autocf}\VST3
CreateAppDir=no
UninstallFilesDir={autopf}\Kirin Mastering\Kirin Hypha
UninstallDisplayName=Kirin Hypha
UninstallDisplayIcon={autocf}\VST3\Kirin Hypha POST.vst3\Contents\x86_64-win\Kirin Hypha POST.vst3
#ifdef WithAax
PrivilegesRequired=admin
#else
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog
#endif
UsePreviousPrivileges=yes
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
DisableDirPage=yes
DisableProgramGroupPage=yes
WizardStyle=modern
CloseApplications=yes
CloseApplicationsFilter=*.*
RestartApplications=no
OutputDir={#OutputDir}
OutputBaseFilename=Kirin-Hypha-{#AppVersion}-Windows-x64-Setup
Compression=lzma2
SolidCompression=yes
#ifdef SignedBuild
SignTool=kirin_esigner
SignToolRetryCount=0
SignedUninstaller=yes
#else
SignedUninstaller=no
#endif

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"

[InstallDelete]
Type: filesandordirs; Name: "{autocf}\VST3\Kirin Hypha PRE.vst3"
Type: filesandordirs; Name: "{autocf}\VST3\Kirin Hypha POST.vst3"
#ifdef WithAax
Type: filesandordirs; Name: "{commoncf}\Avid\Audio\Plug-Ins\Kirin Hypha PRE.aaxplugin"
Type: filesandordirs; Name: "{commoncf}\Avid\Audio\Plug-Ins\Kirin Hypha POST.aaxplugin"
#endif

[Files]
#ifdef LegalDir
Source: "{#LegalDir}\*"; DestDir: "{autopf}\Kirin Mastering\Kirin Hypha\Legal"; Flags: ignoreversion recursesubdirs createallsubdirs
#endif
Source: "{#PreBundle}\*"; DestDir: "{autocf}\VST3\Kirin Hypha PRE.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#PostBundle}\*"; DestDir: "{autocf}\VST3\Kirin Hypha POST.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs
#ifdef WithAax
Source: "{#PreAaxBundle}\*"; DestDir: "{commoncf}\Avid\Audio\Plug-Ins\Kirin Hypha PRE.aaxplugin"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#PostAaxBundle}\*"; DestDir: "{commoncf}\Avid\Audio\Plug-Ins\Kirin Hypha POST.aaxplugin"; Flags: ignoreversion recursesubdirs createallsubdirs
#endif

[CustomMessages]
english.HyphaMigrationReadyMemo=The Windows user who started Setup also has an older Kirin Hypha installed only for that user. Setup first removes that copy as that user, so every DAW loads this version for all users. Settings and DAW projects are kept.
japanese.HyphaMigrationReadyMemo=セットアップを始めたWindowsユーザーには、そのユーザー専用の古いKirin Hyphaも入っています。どのDAWでもこの版を読み込むように、先にそのユーザーの権限で古い版を削除してから、すべてのユーザー用に入れます。設定とDAWのプロジェクトはそのまま残ります。
english.HyphaMigrationInUse=The older Kirin Hypha installed only for the Windows user who started Setup is in use, so nothing was changed and the new version was not installed. Close every DAW and plug-in scanner, then run Setup again.
japanese.HyphaMigrationInUse=セットアップを始めたWindowsユーザー専用の古いKirin Hyphaが使用中のため、何も変更せず、新しい版も入れていません。すべてのDAWとプラグインのスキャンを終了してから、もう一度インストーラーを実行してください。
english.HyphaMigrationFailed=Setup could not check or fully remove the older Kirin Hypha installed only for the Windows user who started Setup, so the new version was not installed. Close every DAW and plug-in scanner, then run Setup again. If this continues, first remove Kirin Hypha in that user's Settings > Apps. Settings and DAW projects were not changed.
japanese.HyphaMigrationFailed=セットアップを始めたWindowsユーザー専用の古いKirin Hyphaを確認または削除しきれなかったため、新しい版は入れていません。すべてのDAWとプラグインのスキャンを終了してから、もう一度インストーラーを実行してください。続く場合は、先にそのユーザーの「設定 > アプリ」からKirin Hyphaを削除してください。設定とDAWのプロジェクトは変更していません。
english.HyphaMigrationUnchecked=Setup could not run Windows PowerShell as the Windows user who started Setup to check for an older Kirin Hypha installed only for that user, so nothing was installed. A security policy may block it; ask the administrator of this computer. Settings and DAW projects were not changed.
japanese.HyphaMigrationUnchecked=セットアップを始めたWindowsユーザーの権限でWindows PowerShellを実行できず、そのユーザー専用の古いKirin Hyphaを確認できなかったため、何も入れていません。セキュリティの設定で止められている可能性があります。このコンピューターの管理者に確認してください。設定とDAWのプロジェクトは変更していません。
english.HyphaAllUsersPresent=Kirin Hypha is already installed for all users. Run Setup for all users (as administrator) so that only one copy exists.
japanese.HyphaAllUsersPresent=Kirin Hyphaはすでにすべてのユーザー用に入っています。コピーが1つだけになるよう、すべてのユーザー用（管理者）でインストーラーを実行してください。

[Code]
// One installation scope at a time. VST3 hosts search the per-user folder as well as the
// all-users folder, so an older current-user copy would keep loading after an all-users update.
// That copy belongs to the Windows user who started Setup, who may differ from the administrator
// account that approved elevation. installer_user_cleanup.ps1 checks and removes it as that user
// (ExecAsOriginalUser) with Windows PowerShell from System32: only that user's exact PRE/POST
// bundles and this AppId's current-user registration, both bundles renamed before anything is
// deleted. Nothing from a user-writable folder runs with administrator rights, and other accounts,
// diagnostics, other products, settings and DAW projects are never changed.
const
  HyphaUninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{B3301A1C-4782-4E36-9B4D-89CC6C5B701E}_is1';
  HyphaUserCopyFound = 10;
  HyphaUserCopyInUse = 20;

// BEGIN generated by scripts/windows/installer_user_cleanup.mjs from installer_user_cleanup.ps1
